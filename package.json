{
  "name": "zhiyu-learning-conquest",
  "version": "1.0.0",
  "private": true,
  "description": "知域：将学习计划转化为策略战棋的微信小程序与 H5 应用",
  "scripts": {
    "dev:h5": "taro build --type h5 --watch",
    "dev:weapp": "taro build --type weapp --watch",
    "build:h5": "taro build --type h5",
    "build:weapp": "taro build --type weapp",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/engine.test.ts tests/territory-geometry.test.ts",
    "test:watch": "tsx --test --watch tests/engine.test.ts tests/territory-geometry.test.ts"
  },
  "browserslist": [
    "last 3 versions",
    "Android >= 5",
    "iOS >= 10"
  ],
  "dependencies": {
    "@babel/runtime": "^7.27.0",
    "@tarojs/components": "4.2.1",
    "@tarojs/helper": "4.2.1",
    "@tarojs/plugin-framework-react": "4.2.1",
    "@tarojs/plugin-platform-h5": "4.2.1",
    "@tarojs/plugin-platform-weapp": "4.2.1",
    "@tarojs/react": "4.2.1",
    "@tarojs/runtime": "4.2.1",
    "@tarojs/shared": "4.2.1",
    "@tarojs/taro": "4.2.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@babel/core": "^7.27.0",
    "@babel/preset-react": "^7.27.1",
    "@pmmmwh/react-refresh-webpack-plugin": "^0.5.17",
    "@tarojs/cli": "4.2.1",
    "@tarojs/webpack5-runner": "4.2.1",
    "@types/react": "^18.3.20",
    "@types/webpack-env": "^1.18.8",
    "babel-preset-taro": "4.2.1",
    "react-refresh": "^0.14.2",
    "sass": "^1.86.0",
    "tsx": "^4.20.6",
    "typescript": "^5.8.3"
  }
}
